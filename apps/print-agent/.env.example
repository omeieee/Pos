# @sds/print-agent environment. Copy to .env next to agent.mjs (never commit it).
# Run with: node --env-file=.env agent.mjs

# The POS API address, no trailing /v1. https only (plain http is accepted for localhost, for tests).
PRINT_API_URL=https://pos.example.com
# The device token of this notebook, issued for a device of kind "print_agent". A secret: keep it
# only in this file. It is never written to the log.
PRINT_DEVICE_TOKEN=replace-with-the-print-agent-device-token

# The Xprinter XP-80T connection:
# - USB on this Windows notebook: set PRINTER_HOST=usb (auto-detects the connected USB printer).
# - LAN on the router: set PRINTER_HOST to its fixed IP (e.g. 192.168.1.50), port 9100.
PRINTER_HOST=usb
PRINTER_PORT=9100
# Optional: specific Windows USB device interface path (leave unset or 'auto' when using USB).
# PRINTER_USB_PATH=auto
# Printable width in dots: 576 (80 mm head), 512 or 384. Confirm on the real printer with --test-print.
PRINTER_WIDTH_DOTS=576
# Connecting plus sending one ticket, in milliseconds (the server holds a claimed job for 30 s).
PRINTER_TIMEOUT_MS=12000
# true = ask the printer for paper-out / cover-open before each ticket. Off until tried on the device.
PRINTER_STATUS_CHECK=false

# How often to ask the server for a job when none is waiting, in milliseconds.
POLL_INTERVAL_MS=2000
HTTP_TIMEOUT_MS=10000
# Where printed job ids are remembered so a lost "printed" reply never prints a ticket twice.
PRINTED_JOBS_FILE=printed-jobs.json
# After Ctrl+C: the longest wait for the ticket in hand, in milliseconds.
STOP_GRACE_MS=30000
