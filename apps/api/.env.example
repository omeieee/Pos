# @sds/api environment. Copy to .env (never commit it) and fill in real values on the host.

# Supabase Supavisor SESSION pooler (port 5432; the direct host is IPv6-only).
# User is postgres.<project-ref>. Placeholder values only.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

# Master key for sign-in secrets: encrypts the owner's TOTP secret and peppers PIN and recovery-code
# hashes. 32 random bytes in base64. Generate once with: openssl rand -base64 32
# Losing or changing it breaks every PIN, the owner's TOTP secret and the recovery codes: the owner
# is locked out until a reset tool exists. Never regenerate it on a rebuild; restore it from the
# offline copy kept with the age backup key, never in git.
AUTH_SECRET_KEY=replace-with-openssl-rand-base64-32-output

PORT=3000
NODE_ENV=production

# Comma-separated browser origins allowed by CORS (pos-web and liff-web on Cloudflare Pages).
CORS_ORIGINS=https://your-pos-web.pages.dev,https://your-liff-web.pages.dev

# Optional: leave empty to disable Sentry.
SENTRY_DSN=

# LINE Messaging API + LIFF (the TEST OA in development). All optional: without them the webhook
# answers 503 and nothing is sent. Never commit real values.
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
LINE_LIFF_ID=

# Named in the LINE privacy notice (data controller and the contact for data requests). Empty keeps
# the built-in defaults.
PRIVACY_CONTROLLER_NAME=
PRIVACY_CONTACT_EMAIL=

# Where transfer slip images are kept (D-24). In the container this is the `slips_data` volume; the
# default is /data/slips. Locally, point it at a throwaway folder. Files are deleted 90 days after the
# payment is confirmed or cancelled.
SLIP_DIR=

# Slip images and expense receipt photos on Cloudflare R2 (D-36). Set all four or none; none keeps the
# files on disk (SLIP_DIR; receipts in its `receipts` folder). R2_ACCOUNT_ID is the 32-character hex
# account id; the key is an R2 API token limited to this one bucket (object read and write). Free quota
# only: 10 GB of Standard storage. Never commit real values.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Reads the amount on a slip with Tesseract inside the container (D-26): a HINT for staff only, never
# a confirmation. Empty = on in production (NODE_ENV=production), off otherwise; `off` turns it off.
# SLIP_OCR_LANG: `tha+eng` (default) or `eng` (lighter). SLIP_OCR_TIMEOUT_MS: default 60000.
SLIP_OCR=
SLIP_OCR_LANG=
SLIP_OCR_TIMEOUT_MS=
# Also reads the small QR printed on a bank slip, in a worker thread (D-26): a duplicate hint only.
# `off` turns it off; empty = on whenever the slip reading is on.
SLIP_QR=

# The bank check of a slip by Slip2Go (D-27), a paid service: it answers whether the transfer exists,
# went to the shop, matches the amount and is newer than the order. `off` (default) or `slip2go`.
# The slip's QR text is sent, or the picture when no QR can be read. Keep SLIP_QR on with it.
SLIP_VERIFIER=
# https URL of the service (default https://connect.slip2go.com) and your SECRET key (required when
# SLIP_VERIFIER=slip2go; never log or commit it). Timeout default 15000 ms; at most this many calls
# per business date (default 100), after that slips are left to the staff tick.
SLIP2GO_BASE_URL=
SLIP2GO_SECRET_KEY=
SLIP2GO_TIMEOUT_MS=
SLIP2GO_DAILY_CAP=
# `on` lets the server confirm a PromptPay payment by itself when Slip2Go says valid (D-27; needs
# SLIP_VERIFIER=slip2go). Default off. Above the ceiling (satang, default 100000 = 1,000 THB) staff
# still confirm by hand.
SLIP_AUTOCONFIRM=
SLIP_AUTOCONFIRM_MAX_SATANG=

# GIT_SHA is baked into the image (docker build --build-arg GIT_SHA=...) and shown by /healthz.
# Do not set it here: an env-file entry, even an empty one, overrides the image value.
