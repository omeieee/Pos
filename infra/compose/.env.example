# /opt/sds/.env on the VM — owner: deploy, mode 600. PLACEHOLDERS ONLY here.
# Create it from the copy CI puts at /opt/sds/.env.example (see infra/SETUP.md).
#
# Quoting rules (compose reads this file):
#   - wrap every value in 'single quotes' so $ and # are taken literally;
#   - inside DATABASE_URL, URL-encode @ : / ? # in the password (e.g. @ -> %40).
# Image tags (API_IMAGE, BACKUP_IMAGE, GIT_SHA) are NOT set here; deploy.sh
# keeps them in /opt/sds/.deploy-state.

# --- Ingress (Caddy) ---------------------------------------------------------
# The ONE place on the VM that names the public IP. Dashes, not dots.
API_HOST='203-0-113-10.sslip.io'
# Let's Encrypt account email (expiry notices).
ACME_EMAIL='you@example.com'

# --- API ---------------------------------------------------------------------
# Supabase SESSION pooler (port 5432, user postgres.<project-ref>), copied from
# Supabase > Connect > Session pooler. Never the 6543 transaction pooler
# (pg-boss needs session locks) and never db.<ref>.supabase.co (IPv6 only).
# Keep the trailing ?sslmode=require: TLS is mandatory, never plaintext. Also turn
# on Supabase > Database > Settings > "Enforce SSL on incoming connections".
DATABASE_URL='postgresql://postgres.PROJECTREF:URL-ENCODED-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require'
# Master key for sign-in secrets (P3 auth): encrypts the owner's TOTP secret and peppers PIN and
# recovery-code hashes. 32 random bytes in base64; generate ONCE with `openssl rand -base64 32`.
# Required: the API refuses to start without it. Changing or losing it forces every PIN and the
# TOTP enrolment to be redone. Keep a copy with the age backup key. Also pass it to the api
# service in docker-compose.yml (environment: AUTH_SECRET_KEY).
AUTH_SECRET_KEY='replace-with-openssl-rand-base64-32-output'
# Comma-separated web app origins (Cloudflare Pages).
CORS_ORIGINS='https://sds-pos.pages.dev,https://sds-order.pages.dev'
# Sentry project DSN for the API (optional; empty disables).
SENTRY_DSN=''
# LINE Messaging API + LIFF (optional until P4 is live; the webhook answers 503 without the secret).
LINE_CHANNEL_ID=''
LINE_CHANNEL_SECRET=''
LINE_CHANNEL_ACCESS_TOKEN=''
LINE_LIFF_ID=''
# Named in the LINE privacy notice. Empty keeps the built-in defaults (omeie and the owner's address).
PRIVACY_CONTROLLER_NAME=''
PRIVACY_CONTACT_EMAIL=''

# --- Backups (OCI Object Storage, S3-compatible) -----------------------------
# age PUBLIC key (age1...). The private key never comes to the VM.
AGE_RECIPIENT='age1replace-with-your-public-key'
# Tenancy > Object Storage namespace (short lowercase string).
OCI_S3_NAMESPACE='namespace'
OCI_S3_REGION='ap-singapore-1'
OCI_S3_BUCKET='sds-backups'
# Profile > Customer secret keys (Access key + Secret shown once).
OCI_S3_ACCESS_KEY_ID='replace-me'
OCI_S3_SECRET_ACCESS_KEY='replace-me'
# healthchecks.io ping URL of the "sds-backup" check.
HC_PING_URL='https://hc-ping.com/00000000-0000-0000-0000-000000000000'
